{
  "name": "vitepress-blog",
  "private": true,
  "type": "module",
  "description": "Blog",
  "author": "zhixiangyao <blueskyzx@icloud.com> <https://github.com/zhixiangyao>",
  "homepage": "https://github.com/zhixiangyao/vitepress-blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiangyao/vitepress-blog.git"
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=11.0.0"
  },
  "keywords": [
    "zhixiangyao",
    "blog",
    "vitepress",
    "vue"
  ],
  "scripts": {
    "dev": "vitepress dev docs --host ",
    "build": "pnpm typecheck && vitepress build docs",
    "preview": "vitepress serve docs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:gifs": "node scripts/optimize-gifs.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "medium-zoom": "1.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.19",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {}
    }
  }
}
